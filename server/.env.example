# Copy to .env for local development. Never put real secrets in the source repository.
# Use an Alibaba Cloud managed PostgreSQL connection string for deployment.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/DB_NAME
SESSION_SECRET=generate_a_long_random_secret
DATA_ENCRYPTION_KEY=generate_a_fernet_key
SESSION_DAYS=30
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000

# Alibaba Cloud Bailian Beijing workspace endpoint, ending with /compatible-mode/v1
BAILIAN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=replace_with_server_side_secret
BAILIAN_MODEL=qwen-flash
BAILIAN_TIMEOUT_SECONDS=60

# Do not enable public access with the prototype keyword filter.
