page{background:#f6f7f3;color:#17211b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;box-sizing:border-box}view,text,button,input,picker{box-sizing:border-box}.page{padding:28rpx 28rpx 44rpx}.brand{display:flex;align-items:center;gap:18rpx;margin-bottom:28rpx}.brand-mark{width:76rpx;height:76rpx;border-radius:24rpx;background:#416b57;color:white;font-size:42rpx;font-weight:700;text-align:center;line-height:76rpx}.brand-name{font-size:38rpx;font-weight:750}.muted{color:#798279}.small{font-size:23rpx}.card{background:#fff;border:1rpx solid #e7e9e3;border-radius:28rpx;padding:28rpx;margin:22rpx 0;box-shadow:0 8rpx 24rpx rgba(35,55,42,.035)}.title{font-size:38rpx;font-weight:750;margin:4rpx 0 10rpx}.section-title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.eyebrow{font-size:23rpx;color:#416b57;font-weight:700;letter-spacing:2rpx}.notice{background:#f1f4ed;border-radius:18rpx;padding:20rpx;color:#657164;line-height:1.6;margin:20rpx 0}.btn{border-radius:18rpx;background:#416b57;color:#fff;font-size:30rpx;font-weight:700;line-height:1.4;padding:20rpx 24rpx;margin:12rpx 0;border:0}.btn::after{border:0}.btn.light{color:#416b57;background:#f1f4ed}.btn.full{width:100%}.btn[disabled]{opacity:.55}.field-label{font-weight:650;margin:22rpx 0 12rpx;display:block}.row{display:flex;align-items:center;gap:14rpx}.input{background:white;border:1rpx solid #e1e5dc;border-radius:18rpx;padding:20rpx;font-size:30rpx}.age-input{width:150rpx}.picker{padding:20rpx 22rpx;border:1rpx solid #e1e5dc;border-radius:18rpx;background:#fff;flex:1}.candidate{padding:26rpx;border:1rpx solid #e6e9e2;border-radius:24rpx;margin:18rpx 0;background:#fff}.candidate-head{display:flex;align-items:center;gap:18rpx}.avatar{width:84rpx;height:84rpx;border-radius:50%;background:#e8f0e9;text-align:center;line-height:84rpx;font-size:46rpx}.candidate-name{font-size:32rpx;font-weight:700}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin:14rpx 0}.tag{background:#f1f4ed;border-radius:999rpx;padding:8rpx 16rpx;color:#476650;font-size:22rpx}.divider{height:1rpx;background:#edf0ea;margin:22rpx 0}.chat-box{height:720rpx;display:flex;flex-direction:column}.messages{flex:1;overflow:auto}.bubble{max-width:86%;border-radius:22rpx;padding:20rpx;margin:14rpx 0;line-height:1.65;background:#f1f3ef}.bubble.user{background:#416b57;color:#fff;margin-left:auto}.composer{display:flex;gap:12rpx;align-items:center;margin-top:20rpx}.composer .input{flex:1}.send{width:100rpx;margin:0;padding:18rpx 0}.footer-note{font-size:22rpx;color:#7d857c;line-height:1.6;margin-top:14rpx}.list-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #edf0ea}.price{font-weight:700;color:#416b57;font-size:32rpx}.danger{color:#a64236}.safe-area{height:32rpx}
